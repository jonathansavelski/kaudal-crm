# --- Cliente (se embebe en el bundle, es publica por diseno) ---
# Panel de Supabase > Project Settings > API Keys > "Publishable key"
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Solo local, solo para scripts/seed.ts ---
# Panel de Supabase > Project Settings > API Keys > "Secret key"
# Saltea RLS: es la unica forma de cargar el seed en tablas de solo lectura.
# NUNCA prefijar con VITE_ (Vite embebe en el bundle todo lo que empiece con VITE_).
# NUNCA cargar esta variable en Netlify.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Solo local, solo para aplicar migraciones y correr el seed ---
# Panel de Supabase > Project Settings > Database > Database password
# Da acceso total a Postgres. Mismo criterio que la Secret key: nunca al repo,
# nunca a Netlify.
SUPABASE_DB_PASSWORD=xxxxxxxxxxxxxxxx

# Host del pooler de sesion. Es REGIONAL: sale de Supabase > Connect > Session
# pooler. Si no se completa, los scripts asumen aws-0-us-east-1.
SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_DB_PORT=5432

# Alternativa mas simple a las tres anteriores: pegar la connection string
# completa que muestra el panel (incluye host, puerto y usuario correctos).
# Si esta cargada, tiene prioridad sobre SUPABASE_DB_PASSWORD/HOST/PORT.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres
